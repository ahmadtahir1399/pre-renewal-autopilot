# Pre-Renewal Autopilot - example configuration. Copy to .env and fill in locally.
# Never commit .env. Leave a value blank to use its default (or to leave it unset).

# LLM (needed from Prompt 2 onward; not needed by any Prompt 1 command)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional. Leave blank to use the model's default; 0 for most deterministic output if the model allows it.
LLM_TEMPERATURE=
# Live LLM calls (scripts/extractOne.ts, scripts/liveCheck.ts) run only when this is true.
RUN_LIVE_LLM=false

# Approval channels: web (default, a page on this computer only), telegram, or both.
APPROVAL_CHANNELS=web
APPROVAL_WEB_PORT=8787
# Optional. Leave blank and serve generates a random token at start (printed to the terminal only).
APPROVAL_WEB_TOKEN=
# Optional, for a deployment behind an HTTPS reverse proxy only: the ONE public origin it serves,
# e.g. https://203-0-113-7.sslip.io. The app still listens on 127.0.0.1. Leave blank for this computer only.
APPROVAL_PUBLIC_ORIGIN=
APPROVER_NAME=broker

# Manual upload and analysis (Prompt 7). Synthetic documents only; their text is sent to the AI provider in live mode.
UPLOAD_MAX_MB=10
UPLOAD_MAX_PAGES=30
UPLOAD_DAILY_LIMIT=10
UPLOAD_RETENTION_DAYS=7
ANALYSIS_TIMEOUT_SECONDS=180
REMINDER_AFTER_HOURS=48
REMINDER_INTERVAL_HOURS=24

# Telegram (OPTIONAL; required only when APPROVAL_CHANNELS includes telegram)
TELEGRAM_BOT_TOKEN=
# Comma separated numeric chat ids allowed to approve, e.g. 111111111,222222222
TELEGRAM_ALLOWED_CHAT_IDS=

# Schedule
TIMEZONE=Pacific/Auckland
RUN_TIME=07:00

# Paths (relative to the project root)
DB_PATH=runtime/autopilot.db
# Read-only fixtures (never written)
FIXTURES_DIR=fixtures
# Writable data; status overlay goes to DATA_DIR/runtime/status-overlay.json
DATA_DIR=data
OUTPUT_DIR=output

# Renewal window in days, inclusive
WINDOW_MIN_DAYS=84
WINDOW_MAX_DAYS=112

# Premium increase thresholds in percent
PREMIUM_MEDIUM_PCT=10
PREMIUM_HIGH_PCT=25

# Safety switches
DRY_RUN=false
AUTOPILOT_ENABLED=true

# Optional fixed "today" (yyyy-mm-dd). The synthetic fixtures are built around 2026-10-19, so the demo
# needs it. Leave it blank to use the real date in TIMEZONE (then the fixture policies drift out of the window).
REFERENCE_DATE=2026-10-19

# Not used: the optional AI wording polish was deliberately not built. Keep false.
USE_AI_SUMMARY=false
# Live AI reading: ask the model ONE more time about facts whose quote could not be found on the page (costs at
# most one extra call per document, only when needed). true (default) or false.
EXTRACT_REPAIR_PASS=true
# Public demo ONLY: no sign-in, uploads allowed through APPROVAL_PUBLIC_ORIGIN. Anyone with the address can use
# everything (and spend from LLM_API_KEY up to UPLOAD_DAILY_LIMIT analyses a day). Leave false for real use.
PUBLIC_DEMO=false
MAX_CONCURRENCY=2
