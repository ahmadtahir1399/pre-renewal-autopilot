{
  "name": "pre-renewal-autopilot",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "Concept portfolio project: draft-only pre-renewal comparison packs for insurance brokers. Synthetic data only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:failure": "vitest run test/failure",
    "test:security": "vitest run test/security test/web.test.ts",
    "lint": "biome lint .",
    "env:check": "tsx scripts/checkEnv.ts",
    "list:due": "tsx scripts/listDue.ts",
    "extract:one": "tsx scripts/extractOne.ts",
    "live:check": "tsx scripts/liveCheck.ts",
    "template:make": "tsx scripts/makeTemplate.ts",
    "build:one": "tsx scripts/buildOne.ts",
    "fixtures:generate": "tsx scripts/generateFixtures.ts",
    "fixtures:verify": "tsx scripts/verifyFixtures.ts",
    "fixtures:hash": "tsx scripts/hashFixtures.ts",
    "autopilot": "tsx src/cli/index.ts",
    "run": "tsx src/cli/index.ts run",
    "status": "tsx src/cli/index.ts status",
    "audit": "tsx src/cli/index.ts audit",
    "pause": "tsx src/cli/index.ts pause",
    "resume": "tsx src/cli/index.ts resume",
    "reset-demo": "tsx src/cli/index.ts reset-demo",
    "serve": "tsx src/cli/index.ts serve",
    "approve": "tsx src/cli/index.ts approve",
    "skip": "tsx src/cli/index.ts skip",
    "retry-sync": "tsx src/cli/index.ts retry-sync",
    "check:approval": "tsx src/cli/index.ts check:approval",
    "analyse": "tsx src/cli/index.ts analyse",
    "uploads:list": "tsx src/cli/index.ts uploads:list",
    "uploads:delete": "tsx src/cli/index.ts uploads:delete",
    "uploads:purge": "tsx src/cli/index.ts uploads:purge",
    "overview": "tsx src/cli/index.ts overview",
    "samples:make": "tsx scripts/makeSampleUploads.ts",
    "check:contrast": "tsx scripts/checkContrast.ts",
    "ui:preview": "tsx scripts/previewUi.ts",
    "ui:states": "tsx scripts/renderUiStates.ts",
    "eval:fake": "tsx scripts/evaluate.ts --mode fake",
    "eval:live": "tsx scripts/evaluate.ts --mode live",
    "results:summary": "tsx scripts/resultsSummary.ts",
    "docs:check-numbers": "tsx scripts/checkNumbers.ts",
    "demo:reset": "tsx scripts/demoReset.ts",
    "demo:warm": "tsx scripts/demoWarm.ts"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "exceljs": "^4.4.0",
    "grammy": "^1.46.0",
    "gsap": "3.15.0",
    "openai": "^7.39.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource-variable/geist": "5.3.0",
    "@types/node": "^24.19.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
